{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:renderer": "vite --port 5173 --strictPort",
    "dev:electron": "wait-on -t 60000 http://localhost:5173 && electron .",
    "dev": "concurrently -k -n renderer,electron -c green,blue \"pnpm:dev:renderer\" \"pnpm:dev:electron\"",
    "dev:all": "pnpm run dev",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "start": "electron ."
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.11.5",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.8.1",
    "concurrently": "^9.2.1",
    "electron": "^38.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.7",
    "vue-tsc": "^3.1.0",
    "wait-on": "^9.0.1"
  }
}
